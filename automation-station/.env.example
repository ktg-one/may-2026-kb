# ─── Copy this to .env, then fill in. Never commit .env. ──────────────────────

# Port n8n binds to on your host. Change if 5678 is taken.
N8N_PORT=5678

# Hostname n8n thinks it lives at. For local dev, localhost is fine.
# For tunnels / remote exposure, set to your hostname / ngrok URL etc.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Timezone for cron-based workflows.
TZ=Asia/Singapore

# Encryption key for credentials stored in n8n. GENERATE ONCE, NEVER CHANGE.
# Losing this = losing all stored credentials. Back it up.
# Generate via: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_ME_openssl_rand_hex_32

# Basic auth — leave off for localhost-only. Turn on if you tunnel / expose.
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# n8n API key — generate inside n8n UI after first start
# (Settings → API → Create API Key). Paste here so n8n-mcp can connect.
N8N_API_KEY=
N8N_API_URL=http://localhost:5678/api/v1
