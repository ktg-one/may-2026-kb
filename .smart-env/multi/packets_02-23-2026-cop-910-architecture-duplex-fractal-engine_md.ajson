3: 文脈 CONTEXTUAL#{1}":[70,82],"#L4: 認知 METACOGNITIVE":[83,89],"#L4: 認知 METACOGNITIVE#{1}":[84,89],"#COUNCIL: MLDoE audit trail":[90,96],"#COUNCIL: MLDoE audit trail#{1}":[91,96],"#═══════════════════════════════════════════════════════════════════════════════[5]":[97,97],"#KEY ARCHITECTURAL INSIGHTS (load-bearing — do not compress)":[98,98],"#═══════════════════════════════════════════════════════════════════════════════[6]":[99,100],"#FRACTAL ENGINE FORMATION PRESETS:":[101,101],"#2x: IMBUED→EXECUTE                                    = Baseline(~60%)":[102,102],"#3x: IMBUED→ENRICH→EXECUTE                             = Competent(~80%)":[103,103],"#4x: IMBUED→EXECUTE→ENRICH→EXECUTE                     = Professional(~92%)":[104,104],"#8x: IMBUED→ENRICH→EXECUTE→[ENRICH→EXECUTE]×3          = Deloitte Standard(~99%)":[105,105],"#nx: recursive until HITL convergence":[106,106],"#Every → = HITL gate. Human = convergence criterion.":[107,108],"#CONTROL LAW SEPARATION (Static Stack Invariant):":[109,109],"#IMBUED  = Compiler control law (scores, routes, compiles — never generates)":[110,110],"#ENRICH  = Analyzer control law (reads, flags, plants bombs — never writes prose)":[111,111],"#EXECUTE = Author control law (writes, detonates bombs — never plans or analyzes)":[112,112],"#Mixing control laws mid-pass = tone drift + logic breaks + hallucination":[113,114],"#WHY BELIEVABLE ≠ TRUE:":[115,115],"#RLHF reward = \"text human rater scores as helpful in <30s evaluation\"":[116,116],"#30s catches: confidence, structure, obvious coverage":[117,117],"#30s misses: 2nd-order effects, softened failure modes, unsourced confident claims":[118,118],"#∴ models optimize for sounding thorough, not being thorough":[119,119],"#嘘契約 + G-08 + HITL = external reward function that CAN tell the difference":[120,120],"#Council doesn't trust AI for this reason — model cannot distinguish pattern-matching-to-correct from actually-correct":[121,122],"#══════════════════════════════════════════════════